{
  "name": "@upratehq/react-native",
  "version": "0.1.0",
  "description": "Uprate SDK for React Native and Expo",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.cjs",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  }
}
